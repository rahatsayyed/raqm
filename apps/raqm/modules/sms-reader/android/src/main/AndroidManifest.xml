<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <!-- The notification-source app picker lists the user's installed apps. Android 11+
       hides other packages without this. Raqm is not distributed through Play, so the
       Play policy restriction on QUERY_ALL_PACKAGES does not apply. -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

  <application>
    <receiver
      android:name=".SmsBroadcastReceiver"
      android:exported="true">
      <intent-filter android:priority="2147483647">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>

    <!-- foregroundServiceType required on API 34+ (targetSdk 36) for startForeground() to
         succeed — "dataSync" fits turning an incoming SMS into stored transaction data. -->
    <service
      android:name=".HeadlessSmsTaskService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <service
      android:name=".RaqmNotificationListenerService"
      android:label="Raqm"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Launched directly by the "Category" notification action's PendingIntent (see
         SmsReaderModule.attachTxActions) instead of MainActivity, so picking a category
         from the notification never brings the app to the foreground. taskAffinity=""
         + excludeFromRecents keeps it out of the app's own task/recents entirely. -->
    <activity
      android:name=".CategoryPickerActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:taskAffinity=""
      android:launchMode="singleInstance"
      android:exported="false" />

    <!-- Handles "Not An Expense"/"Not An Income" and "Add note" natively (see
         NotificationActionReceiver) — exported=false since only our own app's PendingIntents
         (built in SmsReaderModule.attachTxActions) ever target it. -->
    <receiver
      android:name=".NotificationActionReceiver"
      android:exported="false" />

    <!-- Quick Settings tile: static "Add Transaction", opens quick-add via the same
         MainActivity trampoline as the launcher shortcut and the widgets (QuickAdd.kt).
         Android does not permit adding this to the active tile set programmatically — the
         user adds it from the shade's "Edit tiles" panel. -->
    <service
      android:name=".AddTransactionTileService"
      android:label="Add Transaction"
      android:icon="@drawable/ic_tile_add"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <!-- Home-screen widgets (Jetpack Glance). All four declare widgetCategory
         home_screen|keyguard: the lock-screen variant is display-only, since Android's
         keyguard widgets cannot take taps. updatePeriodMillis is 30 min (the platform's
         effective floor); the real freshness comes from the event-driven refresh in
         WidgetRefresh.refreshAll, fired from txStore.refresh(). -->
    <receiver
      android:name=".widget.AddTransactionWidgetReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_add_transaction_info" />
    </receiver>

    <receiver
      android:name=".widget.BudgetWidgetReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_budget_info" />
    </receiver>

    <receiver
      android:name=".widget.CategoryPieWidgetReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_category_pie_info" />
    </receiver>
  </application>
</manifest>
